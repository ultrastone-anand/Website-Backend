  CONTENT
}

enum blog_post_status {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum career_application_status {
  NEW
  REVIEWING
  SHORTLISTED
  INTERVIEW
  SELECTED
  REJECTED
  WITHDRAWN
}

