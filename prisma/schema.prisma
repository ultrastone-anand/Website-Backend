generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model activity_logs {
  id              Int       @id @default(autoincrement())
  user_id         Int?
  action          String?   @db.VarChar(100)
  resource_type   String?   @db.VarChar(100)
  resource_id     BigInt?
  description     String?
  old_values      Json?
  new_values      Json?
  ip_address      String?   @db.VarChar(50)
  user_agent      String?
  created_at      DateTime? @default(now()) @db.Timestamp(6)
  module_name     String?   @db.VarChar(100)
  changed_fields  Json?
  request_id      String?   @db.Uuid
  created_by_name String?   @db.VarChar(255)
  users           users?    @relation(fields: [user_id], references: [id], onUpdate: NoAction)

  @@index([created_at], map: "idx_activity_created")
  @@index([resource_type, resource_id], map: "idx_activity_logs_resource")
  @@index([user_id], map: "idx_activity_user")
  @@index([action], map: "idx_activity_action")
  @@index([module_name], map: "idx_activity_module")
  @@index([request_id], map: "idx_activity_request")
  @@index([resource_type, resource_id, created_at(sort: Desc)], map: "idx_activity_resource_full")
}

model roles {
  id          Int       @id @default(autoincrement())
  role_id     String    @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name        String    @unique @db.VarChar(100)
  description String?
  is_active   Boolean   @default(true)
  created_at  DateTime? @default(now()) @db.Timestamp(6)
  updated_at  DateTime? @default(now()) @db.Timestamp(6)
  users       users[]
}

model showrooms {
  id                      Int       @id @default(autoincrement())
  name                    String    @db.VarChar(255)
  slug                    String    @unique @db.VarChar(150)
  address                 String    @db.VarChar(255)
  city                    String    @db.VarChar(100)
  state                   String    @db.VarChar(100)
  zip_code                String?   @db.VarChar(20)
  country                 String?   @db.VarChar(100)
  primary_phone           String?   @db.VarChar(30)
  secondary_phone         String?   @db.VarChar(30)
  company_phone           String?   @db.VarChar(30)
  email                   String?   @db.VarChar(255)
  latitude                Decimal?  @db.Decimal(10, 8)
  longitude               Decimal?  @db.Decimal(11, 8)
  google_maps_url         String?
  short_description       String?
  long_description        String?
  business_hours_mon_fri  String?   @db.VarChar(100)
  business_hours_saturday String?   @db.VarChar(100)
  business_hours_sunday   String?   @db.VarChar(100)
  image_url               String?
  banner_image_url        String?
  meta_title              String?   @db.VarChar(255)
  meta_description        String?
  is_active               Boolean?  @default(true)
  is_featured             Boolean?  @default(false)
  display_order           Int?      @default(0)
  created_at              DateTime? @default(now()) @db.Timestamp(6)
  updated_at              DateTime? @default(now()) @db.Timestamp(6)
}

model stone_categories {
  id                     Int                @id @default(autoincrement())
  name                   String             @unique @db.VarChar(255)
  slug                   String             @unique @db.VarChar(100)
  description            String?
  parent_id              Int?
  thumbnail_url          String?            @db.VarChar(500)
  banner_url             String?            @db.VarChar(500)
  is_active              Boolean?           @default(true)
  display_order          Int?
  meta_description       String?
  meta_keywords          String?
  seo_title              String?            @db.VarChar(255)
  created_at             DateTime?          @default(now()) @db.Timestamp(6)
  updated_at             DateTime?          @default(now()) @db.Timestamp(6)
  silica_warning         Boolean?           @default(false)
  silica_warning_message String?
  silica_datasheet_url   String?
  stone_categories       stone_categories?  @relation("stone_categoriesTostone_categories", fields: [parent_id], references: [id], onUpdate: NoAction)
  other_stone_categories stone_categories[] @relation("stone_categoriesTostone_categories")
  stone_products         stone_products[]
}

model stone_products {
  id                     BigInt                @id @default(autoincrement())
  product_id             String?               @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  category_id            Int
  name                   String                @db.VarChar(255)
  slug                   String                @unique @db.VarChar(255)
  small_description      String?
  long_description       String?
  finishes_available     String[]
  pattern                String?               @db.VarChar(100)
  thicknesses_cm         String[]
  average_sizes_inches   String[]
  stone_group            String?               @db.VarChar(100)
  translucent            Boolean?              @default(false)
  cut_to_size            Boolean?              @default(false)
  origin_country         String?               @db.VarChar(100)
  pantone_colour         String?               @db.VarChar(100)
  color_enhancing        Boolean?              @default(false)
  countertops_vanities   Boolean?              @default(false)
  interior_floor         Boolean?              @default(false)
  shower_wall            Boolean?              @default(false)
  shower_floor           Boolean?              @default(false)
  exterior_floor         Boolean?              @default(false)
  exterior_wall          Boolean?              @default(false)
  pool_fountain          Boolean?              @default(false)
  fireplace              Boolean?              @default(false)
  furniture_top          Boolean?              @default(false)
  abrasion_resistance    String?               @db.VarChar(20)
  stain_resistance       String?               @db.VarChar(20)
  etching_resistance     String?               @db.VarChar(20)
  heat_resistance        String?               @db.VarChar(20)
  uv_resistance          String?               @db.VarChar(20)
  color_range            String?               @db.VarChar(20)
  movement_index         String?               @db.VarChar(20)
  variation_level        String?               @db.VarChar(10)
  is_featured            Boolean?              @default(false)
  is_trending            Boolean?              @default(false)
  is_new_arrival         Boolean?              @default(false)
  is_active              Boolean?              @default(true)
  created_at             DateTime?             @default(now()) @db.Timestamp(6)
  updated_at             DateTime?             @default(now()) @db.Timestamp(6)
  interior_wall          Boolean?
  sealer                 String?               @db.VarChar(100)
  silica_warning         Boolean?              @default(false)
  silica_warning_message String?
  silica_datasheet_url   String?
  is_published           Boolean?              @default(false)
  product_faqs           product_faqs[]
  product_remarks        product_remarks[]
  media                  stone_product_media[]
  stone_product_seo      stone_product_seo?
  stone_categories       stone_categories      @relation(fields: [category_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model stone_product_media {
  id            BigInt         @id @default(autoincrement())
  product_id    BigInt
  media_type    String         @db.VarChar(30)
  media_url     String
  display_order Int?           @default(0)
  created_at    DateTime?      @default(now()) @db.Timestamp(6)
  public_id     String?
  alt_text      String?
  product       stone_products @relation(fields: [product_id], references: [id], onDelete: Cascade)
}

model users {
  id                   Int               @id @default(autoincrement())
  user_id              String            @unique @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  email                String            @unique @db.VarChar(255)
  password_hash        String            @db.VarChar(255)
  first_name           String?           @db.VarChar(100)
  last_name            String?           @db.VarChar(100)
  is_active            Boolean?          @default(true)
  last_login           DateTime?         @db.Timestamp(6)
  created_at           DateTime?         @default(now()) @db.Timestamp(6)
  updated_at           DateTime?         @default(now()) @db.Timestamp(6)
  deleted_at           DateTime?         @db.Timestamp(6)
  role_id              Int
  must_change_password Boolean?          @default(true)
  activity_logs        activity_logs[]
  product_remarks      product_remarks[]
  roles                roles             @relation(fields: [role_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_users_role")

  @@index([email], map: "idx_users_email")
  @@index([role_id], map: "idx_users_role_id")
}

model sys_lookup {
  id                 BigInt               @id @default(autoincrement())
  lookup_code        String               @unique @db.VarChar(100)
  lookup_name        String               @db.VarChar(255)
  description        String?
  is_active          Boolean?             @default(true)
  display_order      Int?                 @default(1)
  created_at         DateTime?            @default(now()) @db.Timestamp(6)
  updated_at         DateTime?            @default(now()) @db.Timestamp(6)
  sys_lookup_details sys_lookup_details[]
}

model sys_lookup_details {
  id            BigInt     @id @default(autoincrement())
  lookup_id     BigInt
  value_code    String?    @db.VarChar(255)
  value_name    String     @db.VarChar(255)
  description   String?
  display_order Int?       @default(1)
  is_active     Boolean?   @default(true)
  created_at    DateTime?  @default(now()) @db.Timestamp(6)
  updated_at    DateTime?  @default(now()) @db.Timestamp(6)
  sys_lookup    sys_lookup @relation(fields: [lookup_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([lookup_id], map: "idx_lookup_details_lookup_id")
}

model stone_product_seo {
  id               BigInt         @id @default(autoincrement())
  product_id       BigInt         @unique
  meta_title       String?        @db.VarChar(255)
  meta_description String?
  canonical_url    String?
  og_title         String?        @db.VarChar(255)
  og_description   String?
  og_image         String?
  schema_markup    Json?
  robots_index     Boolean        @default(true)
  robots_follow    Boolean        @default(true)
  seo_content      String?
  created_at       DateTime       @default(now()) @db.Timestamp(6)
  updated_at       DateTime       @default(now()) @db.Timestamp(6)
  stone_products   stone_products @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_stone_product_seo_product")

  @@index([meta_title], map: "idx_stone_product_seo_meta_title")
  @@index([product_id], map: "idx_stone_product_seo_product_id")
}

model social_media_links {
  id            BigInt    @id @default(autoincrement())
  platform      String    @db.VarChar(50)
  url           String
  display_order Int?      @default(0)
  is_active     Boolean?  @default(true)
  created_at    DateTime? @default(now()) @db.Timestamp(6)
  updated_at    DateTime? @default(now()) @db.Timestamp(6)
}

model product_faqs {
  id             BigInt         @id @default(autoincrement())
  product_id     BigInt
  question       String         @db.VarChar(500)
  answer         String
  sort_order     Int?           @default(0)
  is_active      Boolean?       @default(true)
  created_at     DateTime?      @default(now()) @db.Timestamp(6)
  updated_at     DateTime?      @default(now()) @db.Timestamp(6)
  stone_products stone_products @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_product_faq_product")

  @@index([product_id], map: "idx_product_faqs_product_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model contact_enquiries {
  id          BigInt   @id @default(autoincrement())
  name        String   @db.VarChar(255)
  subject     String?  @db.VarChar(255)
  email       String   @db.VarChar(255)
  phone       String?  @db.VarChar(50)
  message     String?
  status      String   @default("NEW") @db.VarChar(50)
  assigned_to BigInt?
  notes       String?
  created_at  DateTime @default(now()) @db.Timestamp(6)
  updated_at  DateTime @default(now()) @db.Timestamp(6)
}

model newsletter_subscribers {
  id            BigInt   @id @default(autoincrement())
  email         String   @unique @db.VarChar(255)
  is_active     Boolean  @default(true)
  subscribed_at DateTime @default(now()) @db.Timestamp(6)
  created_by    BigInt?
  updated_by    BigInt?
  created_at    DateTime @default(now()) @db.Timestamp(6)
  updated_at    DateTime @default(now()) @db.Timestamp(6)
}

model product_remarks {
  id             BigInt         @id @default(autoincrement())
  product_id     BigInt
  user_id        Int
  remark         String
  is_edited      Boolean?       @default(false)
  created_at     DateTime?      @default(now()) @db.Timestamp(6)
  updated_at     DateTime?      @default(now()) @db.Timestamp(6)
  stone_products stone_products @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_product_remarks_product")
  users          users          @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_product_remarks_user")

  @@index([created_at(sort: Desc)], map: "idx_product_remarks_created_at")
  @@index([product_id], map: "idx_product_remarks_product_id")
  @@index([user_id], map: "idx_product_remarks_user_id")
}

model page_seo {
  id               Int       @id @default(autoincrement())
  page_id          Int       @unique
  meta_title       String?   @db.VarChar(255)
  meta_description String?
  canonical_url    String?
  og_title         String?   @db.VarChar(255)
  og_image_url     String?
  og_description   String?
  robots_index     String?   @default("index") @db.VarChar(20)
  robots_follow    String?   @default("follow") @db.VarChar(20)
  schema_markup    Json?     @default("{}")
  seo_content      String?
  created_at       DateTime? @default(now()) @db.Timestamp(6)
  updated_at       DateTime? @default(now()) @db.Timestamp(6)
  pages            pages     @relation(fields: [page_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model pages {
  id         Int       @id @default(autoincrement())
  slug       String    @unique @db.VarChar(255)
  title      String    @db.VarChar(255)
  content    Json      @default("{}")
  status     String    @default("draft") @db.VarChar(20)
  created_at DateTime? @default(now()) @db.Timestamp(6)
  updated_at DateTime? @default(now()) @db.Timestamp(6)
  page_seo   page_seo?
}
