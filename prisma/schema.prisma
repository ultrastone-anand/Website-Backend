  title                          String?                        @db.VarChar(255)
  sort_order                     Int                            @default(0)
  is_active                      Boolean                        @default(true)
  created_at                     DateTime                       @default(now()) @db.Timestamp(6)
  updated_at                     DateTime                       @default(now()) @db.Timestamp(6)
  inspiration_gallery_categories inspiration_gallery_categories @relation(fields: [category_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_inspiration_gallery_category")

  @@index([category_id], map: "idx_inspiration_gallery_images_category_id")
